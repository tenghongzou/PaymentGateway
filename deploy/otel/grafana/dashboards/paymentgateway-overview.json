{
  "uid": "pg-overview",
  "title": "PaymentGateway / Overview",
  "tags": ["paymentgateway"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "provider",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(pg_payment_total, provider)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Payments / s by status",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(pg_payment_total{provider=~\"$provider\"}[1m]))", "legendFormat": "{{status}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Provider latency p50 / p99",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(pg_provider_latency_seconds_bucket{provider=~\"$provider\"}[5m])))", "legendFormat": "p50 {{provider}}" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le, provider) (rate(pg_provider_latency_seconds_bucket{provider=~\"$provider\"}[5m])))", "legendFormat": "p99 {{provider}}" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "api-gateway request latency p99 (SLO 300ms)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.3 }] } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.99, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{service_name=\"api-gateway\"}[5m])))", "legendFormat": "{{http_route}}" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "api-gateway status codes / s",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"api-gateway\"}[1m]))", "legendFormat": "{{http_response_status_code}}" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Outbox lag (s) by service",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "max by (service_name) (pg_outbox_lag_seconds)", "legendFormat": "{{service_name}}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Webhook deliveries / s by result",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (result) (rate(pg_webhook_delivery_total[1m]))", "legendFormat": "{{result}}" }]
    },
    {
      "id": 7, "type": "stat", "title": "Ledger imbalance total (must be 0)",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "sum(pg_ledger_imbalance_total) or vector(0)" }]
    }
  ]
}
