# Copy to deploy/compose/.env and adjust. All values have sane defaults in docker-compose.yaml.
# docker compose automatically loads .env from the directory containing the compose file.

# Image tag used for build + run (make compose-up passes VERSION from git describe)
VERSION=dev

# ---- Infrastructure ---------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# Per-service role passwords (roles come from deploy/compose/postgres/init.sql; dev uses the *_owner role)
PG_DB_PASSWORD_MERCHANT=merchant_owner
PG_DB_PASSWORD_PAYMENT=payment_owner
PG_DB_PASSWORD_LEDGER=ledger_owner
PG_DB_PASSWORD_WEBHOOK=webhook_owner
PG_DB_PASSWORD_RECON=recon_owner
REDIS_PORT=6379
KAFKA_HOST_PORT=29092
KAFKA_CLUSTER_ID=pg-local-kraft-cluster-01

# ---- Observability / tools --------------------------------------------------
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
KAFKA_UI_PORT=8090
VAULT_PORT=8200
VAULT_DEV_ROOT_TOKEN_ID=root

# ---- Application ------------------------------------------------------------
GATEWAY_PORT=8080
PG_LOG_LEVEL=debug
PG_RATE_LIMIT_RPS=100

# api-gateway dev-mode credentials (only honoured when PG_ENV=dev; bypasses merchant-service VerifyApiKey).
# scripts/dev-pay.sh and test/e2e use these defaults.
PG_DEV_API_KEY=pk_test_dev_0000000000000000
PG_DEV_SIGNING_SECRET=sk_test_dev_secret_change_me
PG_DEV_MERCHANT_ID=0190a1b2-c3d4-7e5f-8a9b-000000000001

# provider-mock knobs (simulate PSP behaviour)
PG_MOCK_DEFAULT_LATENCY=50ms
PG_MOCK_FAILURE_RATE=0

# provider-stripe (use Stripe TEST keys only; never commit real values)
PG_STRIPE_API_KEY=sk_test_placeholder
PG_STRIPE_WEBHOOK_SECRET=whsec_placeholder
PG_STRIPE_API_BASE_URL=https://api.stripe.com
